{
  "name": "postgres-source-flink",
  "config": {
    "connector.class": "io.debezium.connector.postgresql.PostgresConnector",
    "tasks.max": "1",
    "slot.name": "debezium_unified",
    "publication.name": "debezium_unified",
    "publication.autocreate.mode": "filtered",
    "database.hostname": "${PSQL_HOST}",
    "database.port": "${PSQL_PORT}",
    "database.user": "${PSQL_USERNAME}",
    "database.password": "${PSQL_PASSWORD}",
    "database.dbname": "${PSQL_DATABASE}",
    "topic.prefix": "abc",
    "table.include.list": "public.citation,public.reference,public.resource,public.mod_corpus_association,public.topic_entity_tag_source,public.mod_referencetype,public.mod,public.referencetype,public.copyright_license,public.cross_reference,public.author,public.obsolete_reference_curie,public.reference_mod_referencetype,public.topic_entity_tag,public.curation_status,public.workflow_tag,public.reference_relation,public.mesh_detail,public.reference_email,public.indexing_priority,public.manual_indexing_tag",
    "decimal.handling.mode": "string",
    "plugin.name": "pgoutput",
    "heartbeat.interval.ms": "10000",
    "topic.heartbeat.prefix": "__debezium-heartbeat.unified",
    "database.tcpKeepAlive": "true",
    "driver.tcpUserTimeout": "30000",
    "database.query.timeout.ms": "300000",
    "driver.connectTimeout": "30000",
    "driver.socketTimeout": "30000",
    "slot.stream.params.status_interval": "10s",
    "poll.interval.ms": "500",
    "max.queue.size": "16384",
    "max.batch.size": "2048",
    "errors.tolerance": "all",
    "errors.deadletterqueue.topic.name": "debezium.errors.unified",
    "errors.deadletterqueue.topic.replication.factor": "1",
    "errors.deadletterqueue.context.headers.enable": "true",
    "errors.log.enable": "true",
    "errors.log.include.messages": "true"
  }
}
