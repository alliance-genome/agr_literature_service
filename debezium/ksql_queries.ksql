{"ksql":

"
SET 'auto.offset.reset' = 'earliest';

CREATE TABLE reference (
    reference_id string PRIMARY KEY,
    curie string,
    abstract string,
    category string,
    citation_id string,
    copyright_license_id string,
    date_arrived_in_pubmed string,
    date_created bigint,
    date_last_modified_in_pubmed string,
    date_published string,
    date_published_start string,
    date_published_end string,
    date_updated bigint,
    issue_name string,
    keywords array<string>,
    language string,
    page_range string,
    plain_language_abstract string,
    publisher string,
    pubmed_abstract_languages array<string>,
    pubmed_publication_status string,
    pubmed_types array<string>,
    resource_id string,
    title string,
    volume string,
    retraction_status string,
    can_display_image boolean,
    image_count integer
  ) WITH (
    KAFKA_TOPIC='abc.public.reference',
    VALUE_FORMAT='json'
  );

CREATE TABLE normalized_copyright_reference AS
  SELECT
    reference_id,
    curie,
    abstract,
    category,
    citation_id,
    CASE
      WHEN copyright_license_id IS NULL THEN '__EMPTY__'
      ELSE copyright_license_id
    END AS copyright_license_id,
    date_arrived_in_pubmed,
    date_created,
    date_last_modified_in_pubmed,
    date_published,
    date_published_start,
    date_published_end,
    date_updated,
    issue_name,
    keywords,
    language,
    page_range,
    plain_language_abstract,
    publisher,
    pubmed_abstract_languages,
    pubmed_publication_status,
    pubmed_types,
    CASE
      WHEN resource_id IS NULL THEN '__EMPTY__'
      ELSE resource_id
    END AS resource_id,
    title,
    volume,
    retraction_status,
    can_display_image,
    image_count
  FROM reference
  EMIT CHANGES;

CREATE TABLE cross_reference (
    ROWKEY string PRIMARY KEY,
    reference_id string,
    curie string,
    is_obsolete boolean
  ) WITH (
    KAFKA_TOPIC='abc.public.cross_reference',
    VALUE_FORMAT='json'
  );

CREATE TABLE author (
    ROWKEY string PRIMARY KEY,
    reference_id string,
    orcid string,
    name string,
    author_order integer
  ) WITH (
    KAFKA_TOPIC='abc.public.author',
    VALUE_FORMAT='json'
  );

CREATE TABLE mod (
    mod_id string PRIMARY KEY,
    abbreviation string
  ) WITH (
    KAFKA_TOPIC='abc.public.mod',
    VALUE_FORMAT='json',
    KEY_FORMAT='json'
  );

CREATE TABLE mod_corpus_association (
    mod_corpus_association_id string PRIMARY KEY,
    mod_id string,
    reference_id string,
    corpus boolean
  ) WITH (
    KAFKA_TOPIC='abc.public.mod_corpus_association',
    VALUE_FORMAT='json',
    KEY_FORMAT='json'
  );

CREATE TABLE obsolete_reference_curie (
    obsolete_id string PRIMARY KEY,
    curie string,
    new_id string
  ) WITH (
    KAFKA_TOPIC='abc.public.obsolete_reference_curie',
    VALUE_FORMAT='json',
    KEY_FORMAT='json'
  );

CREATE TABLE citation (
    citation_id string PRIMARY KEY,
    citation string,
    short_citation string
  ) WITH (
    KAFKA_TOPIC='abc.public.citation',
    VALUE_FORMAT='json',
    KEY_FORMAT='json'
);

CREATE TABLE referencetype(
    referencetype_id string PRIMARY KEY,
    label string
  ) WITH (
    KAFKA_TOPIC='abc.public.referencetype',
    VALUE_FORMAT='json',
    KEY_FORMAT='json'
);

CREATE TABLE mod_referencetype(
    mod_referencetype_id string PRIMARY KEY,
    mod_id string,
    referencetype_id string,
    display_order string
  ) WITH (
    KAFKA_TOPIC='abc.public.mod_referencetype',
    VALUE_FORMAT='json',
    KEY_FORMAT='json'
);

CREATE TABLE reference_mod_referencetype(
    reference_mod_referencetype_id string PRIMARY KEY,
    reference_id string,
    mod_referencetype_id string
  ) WITH (
    KAFKA_TOPIC='abc.public.reference_mod_referencetype',
    VALUE_FORMAT='json',
    KEY_FORMAT='json'
);

CREATE TABLE topic_entity_tag_source(
    topic_entity_tag_source_id string PRIMARY KEY,
    source_method string,
    data_provider string,
    source_evidence_assertion string
  ) WITH (
    KAFKA_TOPIC='abc.public.topic_entity_tag_source',
    VALUE_FORMAT='json',
    KEY_FORMAT='json'
);

CREATE TABLE topic_entity_tag(
    topic_entity_tag_id string PRIMARY KEY,
    reference_id string,
    \"topic\" string,
    entity_type string,
    date_created string,
    date_updated string,
    created_by string,
    updated_by string,
    entity string,
    entity_published_as string,
    species string,
    display_tag string,
    confidence_level string,
    confidence_score double,
    negated boolean,
    note string,
    topic_entity_tag_source_id string,
    data_novelty string,
    validation_by_professional_biocurator string,
    entity_id_validation string
  ) WITH (
    KAFKA_TOPIC='abc.public.topic_entity_tag',
    VALUE_FORMAT='json',
    KEY_FORMAT='json'
);

CREATE TABLE curation_status(
    curation_status_id string PRIMARY KEY,
    \"topic\" string,
    reference_id string,
    mod_id string,
    curation_status string,
    note string,
    date_created string,
    date_updated string,
    created_by string,
    updated_by string,
    curation_tag string
) WITH (
    KAFKA_TOPIC='abc.public.curation_status',
    VALUE_FORMAT='json',
    KEY_FORMAT='json'
);

CREATE TABLE curation_status_with_mod AS
    SELECT
    curation_status.curation_status_id AS CURATION_STATUS_ID,
    curation_status.\"topic\" \"TOPIC\",
    curation_status.reference_id,
    curation_status.curation_status,
    mod.abbreviation
    FROM curation_status
    JOIN mod ON
    curation_status.mod_id = mod.mod_id;

CREATE TABLE curation_tags AS
    SELECT reference_id \"REFERENCE_ID\",
    collect_list(map('topic':=\"TOPIC\", 'curation_status':=curation_status, 'abbreviation':=abbreviation )) \"CURATION_TAGS\"
    FROM curation_status_with_mod
    GROUP BY reference_id
    EMIT CHANGES;

CREATE TABLE topic_entity_tag_with_source AS
    SELECT
    topic_entity_tag.topic_entity_tag_id \"TOPIC_ENTITY_TAG_ID\",
    topic_entity_tag.reference_id,
    topic_entity_tag.\"topic\" \"TOPIC\",
    topic_entity_tag.entity_type,
    topic_entity_tag.date_created,
    topic_entity_tag.date_updated,
    topic_entity_tag.created_by,
    topic_entity_tag.updated_by,
    topic_entity_tag.entity,
    topic_entity_tag.entity_published_as,
    topic_entity_tag.species,
    topic_entity_tag.display_tag,
    topic_entity_tag.confidence_level,
    topic_entity_tag.confidence_score,
    topic_entity_tag.negated,
    topic_entity_tag.note,
    topic_entity_tag.topic_entity_tag_source_id,
    topic_entity_tag.data_novelty,
    topic_entity_tag.validation_by_professional_biocurator,
    topic_entity_tag.entity_id_validation,
    topic_entity_tag_source.source_method,
    topic_entity_tag_source.data_provider,
    topic_entity_tag_source.source_evidence_assertion,

    CASE
      WHEN topic_entity_tag_source.source_evidence_assertion IN ('ATP:0000036', 'ATP:0000035')
        THEN 'ECO:0006155'
      ELSE 'ECO:0007669'
    END AS source_evidence_assertion_group

    FROM topic_entity_tag topic_entity_tag
    JOIN topic_entity_tag_source topic_entity_tag_source ON
    topic_entity_tag.topic_entity_tag_source_id = topic_entity_tag_source.topic_entity_tag_source_id
    EMIT CHANGES;

CREATE TABLE topic_entity_tags AS
    SELECT reference_id \"REFERENCE_ID\",
    collect_list(map('topic':=\"TOPIC\", 'entity_type':=entity_type, 'entity':=entity, 'entity_published_as':=entity_published_as, 'species':=species, 'display_tag':=display_tag, 'confidence_level':=confidence_level, 'confidence_score':=cast(confidence_score as string), 'negated':=cast(negated as string), 'data_novelty':=data_novelty, 'validation_by_professional_biocurator':=validation_by_professional_biocurator, 'source_method':=source_method, 'data_provider':= data_provider, 'source_evidence_assertion':=source_evidence_assertion, 'source_evidence_assertion_group':=source_evidence_assertion_group)) \"TOPIC_ENTITY_TAGS\"
    FROM topic_entity_tag_with_source
    GROUP BY reference_id
    EMIT CHANGES;

CREATE TABLE cross_references AS
    SELECT reference_id \"REFERENCE_ID\",
    collect_list(map('curie':=curie, 'is_obsolete':=cast(is_obsolete as string))) \"CROSS_REFERENCES\"
    FROM cross_reference
    GROUP BY reference_id
    EMIT CHANGES;

CREATE TABLE authors AS
    SELECT reference_id \"REFERENCE_ID\",
    collect_list(map('name':=name, 'orcid':=orcid, 'author_order':=cast(author_order as string))) \"AUTHORS\"
    FROM author
    GROUP BY reference_id
    EMIT CHANGES;

CREATE TABLE mods_in_corpus AS
    SELECT mod_corpus_association.reference_id \"REFERENCE_ID\",
    collect_list(mod.abbreviation) \"MODS_IN_CORPUS\"
    FROM mod_corpus_association
    JOIN mod
    ON mod_corpus_association.mod_id = mod.mod_id
    WHERE mod_corpus_association.corpus = true
    GROUP BY mod_corpus_association.reference_id
    EMIT CHANGES;

CREATE TABLE mods_needs_review AS
    SELECT mod_corpus_association.reference_id \"REFERENCE_ID\",
    collect_list(mod.abbreviation) \"MODS_NEEDS_REVIEW\"
    FROM mod_corpus_association
    JOIN mod
    ON mod_corpus_association.mod_id = mod.mod_id
    WHERE mod_corpus_association.corpus is NULL
    GROUP BY mod_corpus_association.reference_id
    EMIT CHANGES;

CREATE TABLE mods_in_corpus_or_needs_review AS
    SELECT mod_corpus_association.reference_id \"REFERENCE_ID\",
    collect_list(mod.abbreviation) \"MODS_IN_CORPUS_OR_NEEDS_REVIEW\"
    FROM mod_corpus_association
    JOIN mod
    ON mod_corpus_association.mod_id = mod.mod_id
    WHERE mod_corpus_association.corpus is NULL OR mod_corpus_association.corpus = true
    GROUP BY mod_corpus_association.reference_id
    EMIT CHANGES;

CREATE TABLE mod_referencetype_referencetype AS
    SELECT mod_referencetype.mod_referencetype_id \"MOD_REFERENCETYPE_ID\",
    referencetype.label \"LABEL\"
    FROM mod_referencetype
    JOIN referencetype
    ON mod_referencetype.referencetype_id = referencetype.referencetype_id
    EMIT CHANGES;

CREATE TABLE mod_referencetype_referencetype_full AS
    SELECT reference_mod_referencetype.reference_id \"REFERENCE_ID\",
    collect_list(mod_referencetype_referencetype.label) \"LABEL\"
    FROM reference_mod_referencetype
    JOIN mod_referencetype_referencetype
    ON mod_referencetype_referencetype.mod_referencetype_id = reference_mod_referencetype.mod_referencetype_id
    GROUP BY reference_mod_referencetype.reference_id
    EMIT CHANGES;

CREATE TABLE obsolete_curies AS
    SELECT new_id \"REFERENCE_ID\",
    collect_list(curie) \"OBSOLETE_CURIES\"
    FROM obsolete_reference_curie
    GROUP BY new_id
    EMIT CHANGES;

CREATE TABLE reference_workflow_tag(
    reference_workflow_tag_id string PRIMARY KEY,
    reference_id string,
    workflow_tag_id string,
    mod_id string,
    created_by string
  ) WITH (
    KAFKA_TOPIC='abc.public.workflow_tag',
    VALUE_FORMAT='json',
    KEY_FORMAT='json'
);

CREATE TABLE reference_workflow_tag_with_mod AS
    SELECT
        reference_workflow_tag.reference_workflow_tag_id AS REFERENCE_WORKFLOW_TAG_ID,
        reference_workflow_tag.reference_id,
        reference_workflow_tag.workflow_tag_id,
        mod.abbreviation AS mod_abbreviation,
        reference_workflow_tag.created_by
    FROM reference_workflow_tag
    JOIN mod
        ON reference_workflow_tag.mod_id = mod.mod_id;

CREATE TABLE reference_workflow_tags AS
    SELECT reference_workflow_tag_with_mod.reference_id \"REFERENCE_ID\",
    collect_list(map('workflow_tag_id':=workflow_tag_id, 'mod_abbreviation':= mod_abbreviation)) \"WORKFLOW_TAGS\"
    FROM reference_workflow_tag_with_mod
    GROUP BY reference_workflow_tag_with_mod.reference_id
    EMIT CHANGES;

CREATE TABLE reference_relation (
    ROWKEY string PRIMARY KEY,
    reference_id_from string,
    reference_id_to string,
    reference_relation_type string
  ) WITH (
    KAFKA_TOPIC='abc.public.reference_relation',
    VALUE_FORMAT='json'
  );

CREATE TABLE copyright_license (
    copyright_license_id string PRIMARY KEY,
    name string,
    url string,
    description string,
    open_access boolean
  ) WITH (
    KAFKA_TOPIC='abc.public.copyright_license',
    VALUE_FORMAT='json',
    KEY_FORMAT='json'
  );

INSERT INTO copyright_license (
  copyright_license_id,
  name,
  url,
  description,
  open_access
) VALUES (
  '__EMPTY__',
  NULL,
  NULL,
  NULL,
  NULL
);

CREATE TABLE mesh_detail (
    mesh_detail_id string PRIMARY KEY,
    reference_id string,
    heading_term string,
    qualifier_term string
  ) WITH (
    KAFKA_TOPIC='abc.public.mesh_detail',
    VALUE_FORMAT='json'
  );

CREATE TABLE reference_email (
    reference_email_id string PRIMARY KEY,
    reference_id string,
    email_address string
  ) WITH (
    KAFKA_TOPIC='abc.public.reference_email',
    VALUE_FORMAT='json'
  );

CREATE TABLE indexing_priority (
    indexing_priority_id string PRIMARY KEY,
    reference_id string,
    mod_id string,
    predicted_indexing_priority string,
    curator_indexing_priority string,
    confidence_score double
  ) WITH (
    KAFKA_TOPIC='abc.public.indexing_priority',
    VALUE_FORMAT='json'
  );

CREATE TABLE manual_indexing_tag (
    manual_indexing_tag_id string PRIMARY KEY,
    reference_id string,
    mod_id string,
    curation_tag string,
    confidence_score double,
    validation_by_biocurator string,
    note string
  ) WITH (
    KAFKA_TOPIC='abc.public.manual_indexing_tag',
    VALUE_FORMAT='json'
  );

CREATE TABLE resource (
    resource_id string PRIMARY KEY,
    title string,
    iso_abbreviation string,
    medline_abbreviation string,
    issn_print string,
    issn_electronic string
  ) WITH (
    KAFKA_TOPIC='abc.public.resource',
    VALUE_FORMAT='json'
  );

INSERT INTO resource (
  resource_id,
  title,
  iso_abbreviation,
  medline_abbreviation,
  issn_print,
  issn_electronic
) VALUES (
  '__EMPTY__',
  NULL,
  NULL,
  NULL,
  NULL,
  NULL
);

CREATE TABLE reference_relations AS
    SELECT reference_id_from \"REFERENCE_ID\",
    collect_list(map('reference_id_to':=reference_id_to, 'reference_relation_type':=reference_relation_type)) \"RELATIONS\"
    FROM reference_relation
    GROUP BY reference_id_from
    EMIT CHANGES;


CREATE TABLE mesh_terms AS
    SELECT reference_id \"REFERENCE_ID\",
    collect_list(map('heading_term':=heading_term, 'qualifier_term':=qualifier_term)) \"MESH_TERMS\"
    FROM mesh_detail
    GROUP BY reference_id
    EMIT CHANGES;

CREATE TABLE reference_emails AS
    SELECT reference_id \"REFERENCE_ID\",
    collect_list(email_address) \"REFERENCE_EMAILS\"
    FROM reference_email
    GROUP BY reference_id
    EMIT CHANGES;

CREATE TABLE indexing_priority_with_mod AS
    SELECT
        indexing_priority.indexing_priority_id AS INDEXING_PRIORITY_ID,
        indexing_priority.reference_id,
        indexing_priority.predicted_indexing_priority,
        indexing_priority.curator_indexing_priority,
        mod.abbreviation AS mod_abbreviation
    FROM indexing_priority
    JOIN mod
        ON indexing_priority.mod_id = mod.mod_id;

CREATE TABLE indexing_priorities AS
    SELECT reference_id \"REFERENCE_ID\",
    collect_list(map('predicted_indexing_priority':=predicted_indexing_priority, 'curator_indexing_priority':=curator_indexing_priority, 'mod_abbreviation':=mod_abbreviation)) \"INDEXING_PRIORITIES\"
    FROM indexing_priority_with_mod
    GROUP BY reference_id
    EMIT CHANGES;

CREATE TABLE manual_indexing_tag_with_mod AS
    SELECT
        manual_indexing_tag.manual_indexing_tag_id AS MANUAL_INDEXING_TAG_ID,
        manual_indexing_tag.reference_id,
        manual_indexing_tag.curation_tag,
        mod.abbreviation AS mod_abbreviation
    FROM manual_indexing_tag
    JOIN mod
        ON manual_indexing_tag.mod_id = mod.mod_id;

CREATE TABLE manual_indexing_tags AS
    SELECT reference_id \"REFERENCE_ID\",
    collect_list(map('curation_tag':=curation_tag, 'mod_abbreviation':=mod_abbreviation)) \"MANUAL_INDEXING_TAGS\"
    FROM manual_indexing_tag_with_mod
    GROUP BY reference_id
    EMIT CHANGES;

-- ==================================================================================================
-- NARROW SPINE + ASCENDING JOIN ORDER (branch ksqldb-spine-reorder) -- PRIVATE index chain.
--
-- The original private chain carried the WIDE reference row through every link: reference_xref
-- restated 30 columns, then 33, 34, 35, 36, ... 43 -- so abstract/title/keywords (~1.6GB of text
-- across 1.29M references) were materialised again at every step. The identical shape in Flink was
-- the wall: state outgrew the RocksDB block cache and the reindex went IOPS-bound -- a narrow spine
-- plus ascending join order took it past the wall that had killed every previous attempt.
--
-- The spine carries ONLY reference_id + citation + the accumulated arrays. The wide columns are
-- attached ONCE, in the final join back to normalized_copyright_reference.
--
-- ORDER IS ASCENDING BY SOURCE SIZE: each link materialises everything accumulated so far, so an
-- aggregate joined first is carried through every remaining link and one joined last through none.
-- The original joined cross_references (4.09M) and authors (7.78M) FIRST -- the two largest, dragged
-- through the whole chain. Source rows, smallest first: obsolete_reference_curie 42,
-- manual_indexing_tag 6,959, curation_status 23,616, reference_email 40,916, indexing_priority
-- 67,495, reference_mod_referencetype 1.30M, mod_corpus_association 1.44M (x3), workflow_tag 2.14M,
-- topic_entity_tag 3.50M, cross_reference 4.09M, author 7.78M.
--
-- The PUBLIC chain gets the same treatment further down, so reference_with_citation,
-- reference_with_resource and reference_with_copyright are gone entirely -- nothing sources from
-- them any more.
-- ==================================================================================================

CREATE TABLE spine_citation AS
    SELECT
    normalized_copyright_reference.reference_id \"REFERENCE_ID\",
    citation.citation \"CITATION\",
    citation.short_citation \"SHORT_CITATION\"
    FROM normalized_copyright_reference normalized_copyright_reference
    JOIN citation citation ON
    normalized_copyright_reference.citation_id = citation.citation_id
    EMIT CHANGES;

CREATE TABLE spine_obs AS
    SELECT
    spine_citation.REFERENCE_ID \"REFERENCE_ID\",
    spine_citation.CITATION \"CITATION\",
    spine_citation.SHORT_CITATION \"SHORT_CITATION\",
    obsolete_curies.OBSOLETE_CURIES \"OBSOLETE_CURIES\"
    FROM spine_citation spine_citation
    LEFT OUTER JOIN obsolete_curies obsolete_curies ON
    spine_citation.REFERENCE_ID = obsolete_curies.REFERENCE_ID
    EMIT CHANGES;

CREATE TABLE spine_mit AS
    SELECT
    spine_obs.REFERENCE_ID \"REFERENCE_ID\",
    spine_obs.CITATION \"CITATION\",
    spine_obs.SHORT_CITATION \"SHORT_CITATION\",
    spine_obs.OBSOLETE_CURIES \"OBSOLETE_CURIES\",
    manual_indexing_tags.MANUAL_INDEXING_TAGS \"MANUAL_INDEXING_TAGS\"
    FROM spine_obs spine_obs
    LEFT OUTER JOIN manual_indexing_tags manual_indexing_tags ON
    spine_obs.REFERENCE_ID = manual_indexing_tags.REFERENCE_ID
    EMIT CHANGES;

CREATE TABLE spine_ctag AS
    SELECT
    spine_mit.REFERENCE_ID \"REFERENCE_ID\",
    spine_mit.CITATION \"CITATION\",
    spine_mit.SHORT_CITATION \"SHORT_CITATION\",
    spine_mit.OBSOLETE_CURIES \"OBSOLETE_CURIES\",
    spine_mit.MANUAL_INDEXING_TAGS \"MANUAL_INDEXING_TAGS\",
    curation_tags.CURATION_TAGS \"CURATION_TAGS\"
    FROM spine_mit spine_mit
    LEFT OUTER JOIN curation_tags curation_tags ON
    spine_mit.REFERENCE_ID = curation_tags.REFERENCE_ID
    EMIT CHANGES;

CREATE TABLE spine_rem AS
    SELECT
    spine_ctag.REFERENCE_ID \"REFERENCE_ID\",
    spine_ctag.CITATION \"CITATION\",
    spine_ctag.SHORT_CITATION \"SHORT_CITATION\",
    spine_ctag.OBSOLETE_CURIES \"OBSOLETE_CURIES\",
    spine_ctag.MANUAL_INDEXING_TAGS \"MANUAL_INDEXING_TAGS\",
    spine_ctag.CURATION_TAGS \"CURATION_TAGS\",
    reference_emails.REFERENCE_EMAILS \"REFERENCE_EMAILS\"
    FROM spine_ctag spine_ctag
    LEFT OUTER JOIN reference_emails reference_emails ON
    spine_ctag.REFERENCE_ID = reference_emails.REFERENCE_ID
    EMIT CHANGES;

CREATE TABLE spine_ip AS
    SELECT
    spine_rem.REFERENCE_ID \"REFERENCE_ID\",
    spine_rem.CITATION \"CITATION\",
    spine_rem.SHORT_CITATION \"SHORT_CITATION\",
    spine_rem.OBSOLETE_CURIES \"OBSOLETE_CURIES\",
    spine_rem.MANUAL_INDEXING_TAGS \"MANUAL_INDEXING_TAGS\",
    spine_rem.CURATION_TAGS \"CURATION_TAGS\",
    spine_rem.REFERENCE_EMAILS \"REFERENCE_EMAILS\",
    indexing_priorities.INDEXING_PRIORITIES \"INDEXING_PRIORITIES\"
    FROM spine_rem spine_rem
    LEFT OUTER JOIN indexing_priorities indexing_priorities ON
    spine_rem.REFERENCE_ID = indexing_priorities.REFERENCE_ID
    EMIT CHANGES;

CREATE TABLE spine_mrt AS
    SELECT
    spine_ip.REFERENCE_ID \"REFERENCE_ID\",
    spine_ip.CITATION \"CITATION\",
    spine_ip.SHORT_CITATION \"SHORT_CITATION\",
    spine_ip.OBSOLETE_CURIES \"OBSOLETE_CURIES\",
    spine_ip.MANUAL_INDEXING_TAGS \"MANUAL_INDEXING_TAGS\",
    spine_ip.CURATION_TAGS \"CURATION_TAGS\",
    spine_ip.REFERENCE_EMAILS \"REFERENCE_EMAILS\",
    spine_ip.INDEXING_PRIORITIES \"INDEXING_PRIORITIES\",
    mod_referencetype_referencetype_full.LABEL \"LABEL\"
    FROM spine_ip spine_ip
    LEFT OUTER JOIN mod_referencetype_referencetype_full mod_referencetype_referencetype_full ON
    spine_ip.REFERENCE_ID = mod_referencetype_referencetype_full.REFERENCE_ID
    EMIT CHANGES;

CREATE TABLE spine_mic AS
    SELECT
    spine_mrt.REFERENCE_ID \"REFERENCE_ID\",
    spine_mrt.CITATION \"CITATION\",
    spine_mrt.SHORT_CITATION \"SHORT_CITATION\",
    spine_mrt.OBSOLETE_CURIES \"OBSOLETE_CURIES\",
    spine_mrt.MANUAL_INDEXING_TAGS \"MANUAL_INDEXING_TAGS\",
    spine_mrt.CURATION_TAGS \"CURATION_TAGS\",
    spine_mrt.REFERENCE_EMAILS \"REFERENCE_EMAILS\",
    spine_mrt.INDEXING_PRIORITIES \"INDEXING_PRIORITIES\",
    spine_mrt.LABEL \"LABEL\",
    mods_in_corpus.MODS_IN_CORPUS \"MODS_IN_CORPUS\"
    FROM spine_mrt spine_mrt
    LEFT OUTER JOIN mods_in_corpus mods_in_corpus ON
    spine_mrt.REFERENCE_ID = mods_in_corpus.REFERENCE_ID
    EMIT CHANGES;

CREATE TABLE spine_mnr AS
    SELECT
    spine_mic.REFERENCE_ID \"REFERENCE_ID\",
    spine_mic.CITATION \"CITATION\",
    spine_mic.SHORT_CITATION \"SHORT_CITATION\",
    spine_mic.OBSOLETE_CURIES \"OBSOLETE_CURIES\",
    spine_mic.MANUAL_INDEXING_TAGS \"MANUAL_INDEXING_TAGS\",
    spine_mic.CURATION_TAGS \"CURATION_TAGS\",
    spine_mic.REFERENCE_EMAILS \"REFERENCE_EMAILS\",
    spine_mic.INDEXING_PRIORITIES \"INDEXING_PRIORITIES\",
    spine_mic.LABEL \"LABEL\",
    spine_mic.MODS_IN_CORPUS \"MODS_IN_CORPUS\",
    mods_needs_review.MODS_NEEDS_REVIEW \"MODS_NEEDS_REVIEW\"
    FROM spine_mic spine_mic
    LEFT OUTER JOIN mods_needs_review mods_needs_review ON
    spine_mic.REFERENCE_ID = mods_needs_review.REFERENCE_ID
    EMIT CHANGES;

CREATE TABLE spine_mcr AS
    SELECT
    spine_mnr.REFERENCE_ID \"REFERENCE_ID\",
    spine_mnr.CITATION \"CITATION\",
    spine_mnr.SHORT_CITATION \"SHORT_CITATION\",
    spine_mnr.OBSOLETE_CURIES \"OBSOLETE_CURIES\",
    spine_mnr.MANUAL_INDEXING_TAGS \"MANUAL_INDEXING_TAGS\",
    spine_mnr.CURATION_TAGS \"CURATION_TAGS\",
    spine_mnr.REFERENCE_EMAILS \"REFERENCE_EMAILS\",
    spine_mnr.INDEXING_PRIORITIES \"INDEXING_PRIORITIES\",
    spine_mnr.LABEL \"LABEL\",
    spine_mnr.MODS_IN_CORPUS \"MODS_IN_CORPUS\",
    spine_mnr.MODS_NEEDS_REVIEW \"MODS_NEEDS_REVIEW\",
    mods_in_corpus_or_needs_review.MODS_IN_CORPUS_OR_NEEDS_REVIEW \"MODS_IN_CORPUS_OR_NEEDS_REVIEW\"
    FROM spine_mnr spine_mnr
    LEFT OUTER JOIN mods_in_corpus_or_needs_review mods_in_corpus_or_needs_review ON
    spine_mnr.REFERENCE_ID = mods_in_corpus_or_needs_review.REFERENCE_ID
    EMIT CHANGES;

CREATE TABLE spine_wf AS
    SELECT
    spine_mcr.REFERENCE_ID \"REFERENCE_ID\",
    spine_mcr.CITATION \"CITATION\",
    spine_mcr.SHORT_CITATION \"SHORT_CITATION\",
    spine_mcr.OBSOLETE_CURIES \"OBSOLETE_CURIES\",
    spine_mcr.MANUAL_INDEXING_TAGS \"MANUAL_INDEXING_TAGS\",
    spine_mcr.CURATION_TAGS \"CURATION_TAGS\",
    spine_mcr.REFERENCE_EMAILS \"REFERENCE_EMAILS\",
    spine_mcr.INDEXING_PRIORITIES \"INDEXING_PRIORITIES\",
    spine_mcr.LABEL \"LABEL\",
    spine_mcr.MODS_IN_CORPUS \"MODS_IN_CORPUS\",
    spine_mcr.MODS_NEEDS_REVIEW \"MODS_NEEDS_REVIEW\",
    spine_mcr.MODS_IN_CORPUS_OR_NEEDS_REVIEW \"MODS_IN_CORPUS_OR_NEEDS_REVIEW\",
    reference_workflow_tags.WORKFLOW_TAGS \"WORKFLOW_TAGS\"
    FROM spine_mcr spine_mcr
    LEFT OUTER JOIN reference_workflow_tags reference_workflow_tags ON
    spine_mcr.REFERENCE_ID = reference_workflow_tags.REFERENCE_ID
    EMIT CHANGES;

CREATE TABLE spine_tet AS
    SELECT
    spine_wf.REFERENCE_ID \"REFERENCE_ID\",
    spine_wf.CITATION \"CITATION\",
    spine_wf.SHORT_CITATION \"SHORT_CITATION\",
    spine_wf.OBSOLETE_CURIES \"OBSOLETE_CURIES\",
    spine_wf.MANUAL_INDEXING_TAGS \"MANUAL_INDEXING_TAGS\",
    spine_wf.CURATION_TAGS \"CURATION_TAGS\",
    spine_wf.REFERENCE_EMAILS \"REFERENCE_EMAILS\",
    spine_wf.INDEXING_PRIORITIES \"INDEXING_PRIORITIES\",
    spine_wf.LABEL \"LABEL\",
    spine_wf.MODS_IN_CORPUS \"MODS_IN_CORPUS\",
    spine_wf.MODS_NEEDS_REVIEW \"MODS_NEEDS_REVIEW\",
    spine_wf.MODS_IN_CORPUS_OR_NEEDS_REVIEW \"MODS_IN_CORPUS_OR_NEEDS_REVIEW\",
    spine_wf.WORKFLOW_TAGS \"WORKFLOW_TAGS\",
    topic_entity_tags.TOPIC_ENTITY_TAGS \"TOPIC_ENTITY_TAGS\"
    FROM spine_wf spine_wf
    LEFT OUTER JOIN topic_entity_tags topic_entity_tags ON
    spine_wf.REFERENCE_ID = topic_entity_tags.REFERENCE_ID
    EMIT CHANGES;

CREATE TABLE spine_xref AS
    SELECT
    spine_tet.REFERENCE_ID \"REFERENCE_ID\",
    spine_tet.CITATION \"CITATION\",
    spine_tet.SHORT_CITATION \"SHORT_CITATION\",
    spine_tet.OBSOLETE_CURIES \"OBSOLETE_CURIES\",
    spine_tet.MANUAL_INDEXING_TAGS \"MANUAL_INDEXING_TAGS\",
    spine_tet.CURATION_TAGS \"CURATION_TAGS\",
    spine_tet.REFERENCE_EMAILS \"REFERENCE_EMAILS\",
    spine_tet.INDEXING_PRIORITIES \"INDEXING_PRIORITIES\",
    spine_tet.LABEL \"LABEL\",
    spine_tet.MODS_IN_CORPUS \"MODS_IN_CORPUS\",
    spine_tet.MODS_NEEDS_REVIEW \"MODS_NEEDS_REVIEW\",
    spine_tet.MODS_IN_CORPUS_OR_NEEDS_REVIEW \"MODS_IN_CORPUS_OR_NEEDS_REVIEW\",
    spine_tet.WORKFLOW_TAGS \"WORKFLOW_TAGS\",
    spine_tet.TOPIC_ENTITY_TAGS \"TOPIC_ENTITY_TAGS\",
    cross_references.CROSS_REFERENCES \"CROSS_REFERENCES\"
    FROM spine_tet spine_tet
    LEFT OUTER JOIN cross_references cross_references ON
    spine_tet.REFERENCE_ID = cross_references.REFERENCE_ID
    EMIT CHANGES;

CREATE TABLE spine_auth AS
    SELECT
    spine_xref.REFERENCE_ID \"REFERENCE_ID\",
    spine_xref.CITATION \"CITATION\",
    spine_xref.SHORT_CITATION \"SHORT_CITATION\",
    spine_xref.OBSOLETE_CURIES \"OBSOLETE_CURIES\",
    spine_xref.MANUAL_INDEXING_TAGS \"MANUAL_INDEXING_TAGS\",
    spine_xref.CURATION_TAGS \"CURATION_TAGS\",
    spine_xref.REFERENCE_EMAILS \"REFERENCE_EMAILS\",
    spine_xref.INDEXING_PRIORITIES \"INDEXING_PRIORITIES\",
    spine_xref.LABEL \"LABEL\",
    spine_xref.MODS_IN_CORPUS \"MODS_IN_CORPUS\",
    spine_xref.MODS_NEEDS_REVIEW \"MODS_NEEDS_REVIEW\",
    spine_xref.MODS_IN_CORPUS_OR_NEEDS_REVIEW \"MODS_IN_CORPUS_OR_NEEDS_REVIEW\",
    spine_xref.WORKFLOW_TAGS \"WORKFLOW_TAGS\",
    spine_xref.TOPIC_ENTITY_TAGS \"TOPIC_ENTITY_TAGS\",
    spine_xref.CROSS_REFERENCES \"CROSS_REFERENCES\",
    authors.AUTHORS \"AUTHORS\"
    FROM spine_xref spine_xref
    LEFT OUTER JOIN authors authors ON
    spine_xref.REFERENCE_ID = authors.REFERENCE_ID
    EMIT CHANGES;

-- Wide reference columns attached ONCE here instead of being dragged through 13 links.
CREATE TABLE reference_joined WITH (
    PARTITIONS = 1,
    KAFKA_TOPIC = 'reference_joined',
    VALUE_FORMAT='JSON',
    KEY_FORMAT='JSON'
  ) AS SELECT
    spine_auth.REFERENCE_ID \"reference_id\",
    normalized_copyright_reference.curie \"curie\",
    normalized_copyright_reference.abstract \"abstract\",
    normalized_copyright_reference.category \"category\",
    normalized_copyright_reference.date_arrived_in_pubmed \"date_arrived_in_pubmed\",
    normalized_copyright_reference.date_created \"date_created\",
    normalized_copyright_reference.date_last_modified_in_pubmed \"date_last_modified_in_pubmed\",
    normalized_copyright_reference.date_published \"date_published\",
    normalized_copyright_reference.date_published_start \"date_published_start\",
    normalized_copyright_reference.date_published_end \"date_published_end\",
    normalized_copyright_reference.date_updated \"date_updated\",
    normalized_copyright_reference.issue_name \"issue_name\",
    normalized_copyright_reference.keywords \"keywords\",
    normalized_copyright_reference.language \"language\",
    normalized_copyright_reference.page_range \"page_range\",
    normalized_copyright_reference.plain_language_abstract \"plain_language_abstract\",
    normalized_copyright_reference.publisher \"publisher\",
    normalized_copyright_reference.pubmed_abstract_languages \"pubmed_abstract_languages\",
    normalized_copyright_reference.pubmed_publication_status \"pubmed_publication_status\",
    normalized_copyright_reference.pubmed_types \"pubmed_types\",
    normalized_copyright_reference.resource_id \"resource_id\",
    normalized_copyright_reference.title \"title\",
    normalized_copyright_reference.volume \"volume\",
    normalized_copyright_reference.retraction_status \"retraction_status\",
    normalized_copyright_reference.can_display_image \"can_display_image\",
    normalized_copyright_reference.image_count \"image_count\",
    CASE
      WHEN normalized_copyright_reference.retraction_status = 'ATP:0000346' THEN 'retracted'
      WHEN normalized_copyright_reference.retraction_status = 'ATP:0000347' THEN 'partially retracted'
      WHEN normalized_copyright_reference.retraction_status = 'ATP:0000348' THEN 'fully retracted'
      ELSE NULL
    END AS \"retraction_status_name\",
    spine_auth.CITATION \"citation\",
    spine_auth.SHORT_CITATION \"short_citation\",
    spine_auth.OBSOLETE_CURIES \"obsolete_curies\",
    spine_auth.MANUAL_INDEXING_TAGS \"manual_indexing_tags\",
    spine_auth.CURATION_TAGS \"curation_tags\",
    spine_auth.REFERENCE_EMAILS \"reference_emails\",
    spine_auth.INDEXING_PRIORITIES \"indexing_priorities\",
    spine_auth.LABEL \"mod_reference_types\",
    spine_auth.MODS_IN_CORPUS \"mods_in_corpus\",
    spine_auth.MODS_NEEDS_REVIEW \"mods_needs_review\",
    spine_auth.MODS_IN_CORPUS_OR_NEEDS_REVIEW \"mods_in_corpus_or_needs_review\",
    spine_auth.WORKFLOW_TAGS \"workflow_tags\",
    spine_auth.TOPIC_ENTITY_TAGS \"topic_entity_tags\",
    spine_auth.CROSS_REFERENCES \"cross_references\",
    spine_auth.AUTHORS \"authors\"
    FROM spine_auth spine_auth
    JOIN normalized_copyright_reference normalized_copyright_reference ON
    spine_auth.REFERENCE_ID = normalized_copyright_reference.reference_id
    EMIT CHANGES;

-- ==================================================================================================
-- NARROW SPINE + ASCENDING JOIN ORDER -- PUBLIC index chain.
--
-- Same technique as the private spine above. The old public chain carried the WIDE reference row
-- (abstract/title/keywords) through SEVEN materialisations: reference_with_citation restated 30
-- columns, reference_with_resource another 30, reference_with_copyright 24, and then the four
-- left-deep pairwise intermediates ksqlDB builds for the five-way aggregate join -- each one
-- rewriting those 24 wide columns again. It also dragged plain_language_abstract,
-- pubmed_abstract_languages, date_published_start, date_published_end and date_updated the whole
-- way only to drop them at the end.
--
-- The spine carries ONLY reference_id + citation + two FK ids + the accumulated arrays. The wide
-- columns are attached ONCE, in the final join back to normalized_copyright_reference.
--
-- ORDER IS ASCENDING BY SOURCE SIZE, measured on the prod copy:
--   copyright_license 8, reference_relation 14,925, resource 45,300, mod_corpus_association 1.44M,
--   cross_reference 4.09M, author 7.78M, mesh_detail 18.16M.
-- The old order was close to the inverse: cross_references and authors joined FIRST, mesh_terms
-- (much the largest source in the system) fourth, and mods_in_corpus LAST. That last one is an
-- INNER join and it is what narrows the public index to 1,113,157 of the 1,295,410 references, so
-- every one of the ~182k rows it discards was carried through all four preceding joins first. It
-- now filters fourth, before the three biggest aggregates.
--
-- Output columns are byte-identical to the previous public_reference_joined.
-- ==================================================================================================

CREATE TABLE spine_pub_cit AS
    SELECT
    normalized_copyright_reference.reference_id \"REFERENCE_ID\",
    normalized_copyright_reference.resource_id \"RESOURCE_ID\",
    normalized_copyright_reference.copyright_license_id \"COPYRIGHT_LICENSE_ID\",
    citation.citation \"CITATION\",
    citation.short_citation \"SHORT_CITATION\"
    FROM normalized_copyright_reference normalized_copyright_reference
    JOIN citation citation ON
    normalized_copyright_reference.citation_id = citation.citation_id
    EMIT CHANGES;

CREATE TABLE spine_pub_cl AS
    SELECT
    spine_pub_cit.REFERENCE_ID \"REFERENCE_ID\",
    spine_pub_cit.RESOURCE_ID \"RESOURCE_ID\",
    spine_pub_cit.CITATION \"CITATION\",
    spine_pub_cit.SHORT_CITATION \"SHORT_CITATION\",
    copyright_license.open_access \"OPEN_ACCESS\",
    copyright_license.name \"COPYRIGHT_LICENSE\"
    FROM spine_pub_cit spine_pub_cit
    LEFT OUTER JOIN copyright_license copyright_license ON
    spine_pub_cit.COPYRIGHT_LICENSE_ID = copyright_license.copyright_license_id
    EMIT CHANGES;

CREATE TABLE spine_pub_rel AS
    SELECT
    spine_pub_cl.REFERENCE_ID \"REFERENCE_ID\",
    spine_pub_cl.RESOURCE_ID \"RESOURCE_ID\",
    spine_pub_cl.CITATION \"CITATION\",
    spine_pub_cl.SHORT_CITATION \"SHORT_CITATION\",
    spine_pub_cl.OPEN_ACCESS \"OPEN_ACCESS\",
    spine_pub_cl.COPYRIGHT_LICENSE \"COPYRIGHT_LICENSE\",
    reference_relations.RELATIONS \"RELATIONS\"
    FROM spine_pub_cl spine_pub_cl
    LEFT OUTER JOIN reference_relations reference_relations ON
    spine_pub_cl.REFERENCE_ID = reference_relations.REFERENCE_ID
    EMIT CHANGES;

CREATE TABLE spine_pub_res AS
    SELECT
    spine_pub_rel.REFERENCE_ID \"REFERENCE_ID\",
    spine_pub_rel.CITATION \"CITATION\",
    spine_pub_rel.SHORT_CITATION \"SHORT_CITATION\",
    spine_pub_rel.OPEN_ACCESS \"OPEN_ACCESS\",
    spine_pub_rel.COPYRIGHT_LICENSE \"COPYRIGHT_LICENSE\",
    spine_pub_rel.RELATIONS \"RELATIONS\",
    resource.title \"RESOURCE_TITLE\"
    FROM spine_pub_rel spine_pub_rel
    LEFT OUTER JOIN resource resource ON
    spine_pub_rel.RESOURCE_ID = resource.resource_id
    EMIT CHANGES;

CREATE TABLE spine_pub_mic AS
    SELECT
    spine_pub_res.REFERENCE_ID \"REFERENCE_ID\",
    spine_pub_res.CITATION \"CITATION\",
    spine_pub_res.SHORT_CITATION \"SHORT_CITATION\",
    spine_pub_res.OPEN_ACCESS \"OPEN_ACCESS\",
    spine_pub_res.COPYRIGHT_LICENSE \"COPYRIGHT_LICENSE\",
    spine_pub_res.RELATIONS \"RELATIONS\",
    spine_pub_res.RESOURCE_TITLE \"RESOURCE_TITLE\",
    mods_in_corpus.MODS_IN_CORPUS \"MODS_IN_CORPUS\"
    FROM spine_pub_res spine_pub_res
    JOIN mods_in_corpus mods_in_corpus ON
    spine_pub_res.REFERENCE_ID = mods_in_corpus.REFERENCE_ID
    EMIT CHANGES;

CREATE TABLE spine_pub_xref AS
    SELECT
    spine_pub_mic.REFERENCE_ID \"REFERENCE_ID\",
    spine_pub_mic.CITATION \"CITATION\",
    spine_pub_mic.SHORT_CITATION \"SHORT_CITATION\",
    spine_pub_mic.OPEN_ACCESS \"OPEN_ACCESS\",
    spine_pub_mic.COPYRIGHT_LICENSE \"COPYRIGHT_LICENSE\",
    spine_pub_mic.RELATIONS \"RELATIONS\",
    spine_pub_mic.RESOURCE_TITLE \"RESOURCE_TITLE\",
    spine_pub_mic.MODS_IN_CORPUS \"MODS_IN_CORPUS\",
    cross_references.CROSS_REFERENCES \"CROSS_REFERENCES\"
    FROM spine_pub_mic spine_pub_mic
    LEFT OUTER JOIN cross_references cross_references ON
    spine_pub_mic.REFERENCE_ID = cross_references.REFERENCE_ID
    EMIT CHANGES;

CREATE TABLE spine_pub_auth AS
    SELECT
    spine_pub_xref.REFERENCE_ID \"REFERENCE_ID\",
    spine_pub_xref.CITATION \"CITATION\",
    spine_pub_xref.SHORT_CITATION \"SHORT_CITATION\",
    spine_pub_xref.OPEN_ACCESS \"OPEN_ACCESS\",
    spine_pub_xref.COPYRIGHT_LICENSE \"COPYRIGHT_LICENSE\",
    spine_pub_xref.RELATIONS \"RELATIONS\",
    spine_pub_xref.RESOURCE_TITLE \"RESOURCE_TITLE\",
    spine_pub_xref.MODS_IN_CORPUS \"MODS_IN_CORPUS\",
    spine_pub_xref.CROSS_REFERENCES \"CROSS_REFERENCES\",
    authors.AUTHORS \"AUTHORS\"
    FROM spine_pub_xref spine_pub_xref
    LEFT OUTER JOIN authors authors ON
    spine_pub_xref.REFERENCE_ID = authors.REFERENCE_ID
    EMIT CHANGES;

CREATE TABLE spine_pub_mesh AS
    SELECT
    spine_pub_auth.REFERENCE_ID \"REFERENCE_ID\",
    spine_pub_auth.CITATION \"CITATION\",
    spine_pub_auth.SHORT_CITATION \"SHORT_CITATION\",
    spine_pub_auth.OPEN_ACCESS \"OPEN_ACCESS\",
    spine_pub_auth.COPYRIGHT_LICENSE \"COPYRIGHT_LICENSE\",
    spine_pub_auth.RELATIONS \"RELATIONS\",
    spine_pub_auth.RESOURCE_TITLE \"RESOURCE_TITLE\",
    spine_pub_auth.MODS_IN_CORPUS \"MODS_IN_CORPUS\",
    spine_pub_auth.CROSS_REFERENCES \"CROSS_REFERENCES\",
    spine_pub_auth.AUTHORS \"AUTHORS\",
    mesh_terms.MESH_TERMS \"MESH_TERMS\"
    FROM spine_pub_auth spine_pub_auth
    LEFT OUTER JOIN mesh_terms mesh_terms ON
    spine_pub_auth.REFERENCE_ID = mesh_terms.REFERENCE_ID
    EMIT CHANGES;

-- Wide reference columns attached ONCE here instead of being dragged through the whole chain.
CREATE TABLE public_reference_joined WITH (
    PARTITIONS = 1,
    KAFKA_TOPIC = 'public_reference_joined',
    VALUE_FORMAT='JSON',
    KEY_FORMAT='JSON'
  ) AS SELECT
    spine_pub_mesh.REFERENCE_ID \"reference_id\",
    normalized_copyright_reference.curie \"curie\",
    normalized_copyright_reference.title \"title\",
    normalized_copyright_reference.abstract \"abstract\",
    normalized_copyright_reference.category \"category\",
    normalized_copyright_reference.pubmed_types \"pubmed_types\",
    spine_pub_mesh.RESOURCE_TITLE \"resource_title\",
    normalized_copyright_reference.volume \"volume\",
    normalized_copyright_reference.issue_name \"issue_name\",
    normalized_copyright_reference.page_range \"page_range\",
    normalized_copyright_reference.publisher \"publisher\",
    normalized_copyright_reference.language \"language\",
    normalized_copyright_reference.date_published \"date_published\",
    normalized_copyright_reference.pubmed_publication_status \"pubmed_publication_status\",
    NULLIF(normalized_copyright_reference.date_arrived_in_pubmed, '') \"date_arrived_in_pubmed\",
    NULLIF(normalized_copyright_reference.date_last_modified_in_pubmed, '') \"date_last_modified_in_pubmed\",
    normalized_copyright_reference.date_created \"date_created\",
    normalized_copyright_reference.keywords \"keywords\",
    spine_pub_mesh.CITATION \"citation\",
    spine_pub_mesh.SHORT_CITATION \"short_citation\",
    spine_pub_mesh.OPEN_ACCESS \"open_access\",
    spine_pub_mesh.COPYRIGHT_LICENSE \"copyright_license\",
    normalized_copyright_reference.retraction_status \"retraction_status\",
    CASE
      WHEN normalized_copyright_reference.retraction_status = 'ATP:0000346' THEN 'retracted'
      WHEN normalized_copyright_reference.retraction_status = 'ATP:0000347' THEN 'partially retracted'
      WHEN normalized_copyright_reference.retraction_status = 'ATP:0000348' THEN 'fully retracted'
      ELSE NULL
    END \"retraction_status_name\",
    spine_pub_mesh.CROSS_REFERENCES \"cross_references\",
    spine_pub_mesh.AUTHORS \"authors\",
    spine_pub_mesh.RELATIONS \"relations\",
    spine_pub_mesh.MESH_TERMS \"mesh_terms\",
    spine_pub_mesh.MODS_IN_CORPUS \"mods_in_corpus\"
    FROM spine_pub_mesh spine_pub_mesh
    JOIN normalized_copyright_reference normalized_copyright_reference ON
    spine_pub_mesh.REFERENCE_ID = normalized_copyright_reference.reference_id;
",
"streamsProperties": {}}